# PostgreSQL connection string (required)
# Neon: Settings → Connection string → "Pooled connection" (for app queries)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/cm_ops?sslmode=require"

# Direct (non-pooled) URL — used only by prisma db push during build
# Neon: Settings → Connection string → "Direct connection"
# If you only have one URL, set both to the same value.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/cm_ops?sslmode=require"
