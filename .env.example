# Neon: Dashboard → Connection Details → enable Connection Pooling → copy string
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon: Dashboard → Connection Details → disable Connection Pooling → copy string
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Google OAuth — https://console.cloud.google.com/ → Credentials → OAuth 2.0 Client IDs
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-client-secret"

# Secret for the one-time /api/seed endpoint
SEED_SECRET="change-me-before-seeding"

# Protects the cron endpoints. Set in Vercel + as a GitHub Actions secret so the
# hourly workflow (.github/workflows/hourly-reminders.yml) can trigger run-all.
CRON_SECRET="change-me"

# Amazon S3 — file & image storage
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_S3_BUCKET="your-bucket-name"
AWS_S3_REGION="ap-southeast-1"

# Chiang Mai BOH Public Reporting API — a single multi-branch platform: one key +
# one URL serve every branch (selected per-request via ?branch=<slug>). The
# /performance page reads these to pull live leaderboards. Branch slugs live in
# src/lib/boh-branches.ts.
BOH_API_KEY="boh_live_..."          # the platform key (from the sujeevan.ca team)
# Optional — defaults to https://www.sujeevan.ca (serves all 6 branches).
# Use the www. host, NOT the apex sujeevan.ca: the apex 308-redirects to www and
# drops the x-api-key header on server-to-server calls (→ 401).
# BOH_API_URL="https://www.sujeevan.ca"
#
# Deprecated legacy per-branch keys — accepted only as a last-resort fallback for
# BOH_API_KEY (being retired). Prefer BOH_API_KEY.
# BOH_KEY_YORKMILLS="branch-api-key"
# BOH_KEY_PARKLAWN="branch-api-key"

# Web Push (VAPID) — generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# PUBLIC is exposed to the browser; PRIVATE is a server secret. SUBJECT is a mailto:.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# Anthropic — powers automatic risk analysis on /logbook entries (src/lib/logbook-ai.ts).
# Get a key at https://console.anthropic.com/settings/keys. If unset, entries still
# save fine — they just skip AI classification (no error surfaced to the user).
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# Shared token for the read-only logbook sync API that the external
# AI-operations dashboard pulls from: GET /api/integrations/logbook
# (Authorization: Bearer <token> or ?key=<token>). Set the SAME value here and in
# the external app's "Sync logbook" config. If unset, the endpoint returns 503.
LOGBOOK_SYNC_TOKEN="change-me"
