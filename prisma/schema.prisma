// CM Operational Task Management System — Phase 1 + 2
// Source of truth for entities. Keep field names stable (dashboard + logs depend on them).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  AREA_MANAGER
  STORE_MANAGER
  SHIFT_LEAD
  EMPLOYEE
  NEW_HIRE
  // Single-purpose role: compliance support. Sees only the Compliance page;
  // sits outside the management hierarchy (not a "manager").
  COMPLIANCE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TaskType {
  ONE_OFF
  RECURRING
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  VERIFIED
  OVERDUE
}

// Projects (monday.com "Customer Projects" style) — a project groups related tasks
// for a client/initiative, with an owner, timeline, and budget.
enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum AttachmentType {
  PHOTO
  DOC
  SOP
  VIDEO
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_NEAR_DUE
  TASK_OVERDUE
  ESCALATION
  CHECKLIST_GENERATED
  DAILY_DIGEST
  ANNOUNCEMENT
  INVENTORY_LOW_STOCK
  MAINTENANCE_REPORTED
  MAINTENANCE_ASSIGNED
  MAINTENANCE_RESOLVED
  MAINTENANCE_OVERDUE
  COMPLIANCE_DUE_SOON
  COMPLIANCE_OVERDUE
  MENTION
  TASK_STARTING
}

enum TrainingCategory {
  SOP
  SAFETY
  SERVICE
  PRODUCT
  COMPLIANCE
  OTHER
}

enum LessonType {
  VIDEO
  ARTICLE
  DOCUMENT
  LINK
}

// Phase 5: Inventory
enum InventoryUnit {
  EACH
  KG
  G
  L
  ML
  BOTTLE
  BOX
  PACK
  CASE
}

// Phase 5: Maintenance
enum MaintenanceStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MaintenanceArea {
  EQUIPMENT
  REFRIGERATION
  PLUMBING
  ELECTRICAL
  HVAC
  STRUCTURAL
  SAFETY
  OTHER
}

// Recurring compliance / preventive-maintenance services (anniversary-based).
enum ComplianceCategory {
  PEST_CONTROL
  GREASE_TRAP
  HOOD_CLEANING
  FIRE_SAFETY
  HVAC
  EQUIPMENT
  SANITATION
  LICENSE_PERMIT
  OTHER
}

enum ComplianceInterval {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  WEEKLY
  BIWEEKLY
  BIMONTHLY
}

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  region    String?
  managerId String?
  createdAt DateTime @default(now())

  users               User[]               @relation("UserLocation")
  managedBy           User?                @relation("LocationManager", fields: [managerId], references: [id])
  tasks               Task[]
  activityLog         ActivityLog[]
  checklistTemplates  ChecklistTemplate[]
  announcements       Announcement[]
  trainingMaterials   TrainingMaterial[]
  courses             Course[]
  inventoryItems      InventoryItem[]
  inventoryCounts     InventoryCount[]
  maintenanceRequests MaintenanceRequest[]
  projects            Project[]
  complianceSchedules ComplianceSchedule[]
  messages            Message[]
  serverPerformance   ServerPerformance[]
  dailyNotes          DailyNote[]
  logEntries          LogEntry[]
  reservationImports  ReservationImport[]
  floorZones          FloorZone[]
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  role         Role
  locationId   String?
  phone        String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())

  location              Location?            @relation("UserLocation", fields: [locationId], references: [id])
  managesLocations      Location[]           @relation("LocationManager")
  assignedTasks         Task[]               @relation("Assignee")
  createdTasks          Task[]               @relation("Assigner")
  completions           TaskCompletion[]     @relation("CompletedBy")
  verifications         TaskCompletion[]     @relation("VerifiedBy")
  activityLog           ActivityLog[]
  notifications         Notification[]
  checklistsCreated     ChecklistTemplate[]  @relation("ChecklistCreator")
  checklistsAssigned    ChecklistTemplate[]  @relation("ChecklistAssignee")
  categoriesCreated     Category[]
  announcements         Announcement[]
  announcementReads     AnnouncementRead[]
  trainingMaterials     TrainingMaterial[]
  coursesCreated        Course[]             @relation("CourseCreator")
  comments              Comment[]
  complianceComments    ComplianceComment[]
  maintenanceComments   MaintenanceComment[]
  inventoryItemsCreated InventoryItem[]
  inventoryCounts       InventoryCount[]
  maintenanceReported   MaintenanceRequest[] @relation("MaintReporter")
  maintenanceAssigned   MaintenanceRequest[] @relation("MaintAssignee")
  maintenanceResolved   MaintenanceRequest[] @relation("MaintResolver")
  projectsOwned         Project[]            @relation("ProjectOwner")
  projectsCreated       Project[]            @relation("ProjectCreator")
  complianceAssigned    ComplianceSchedule[] @relation("ComplianceAssignee")
  complianceCreated     ComplianceSchedule[] @relation("ComplianceCreator")
  messages              Message[]
  serverPerformance     ServerPerformance[]  @relation("ServerPerf")
  dailyNotes            DailyNote[]
  notesAbout            PersonNote[]         @relation("NoteSubject")
  notesAuthored         PersonNote[]         @relation("NoteAuthor")
  pushSubscriptions     PushSubscription[]
  mutedPush             String[]             @default([]) // push categories this user opted out of
  logEntriesAuthored    LogEntry[]           @relation("LogEntryAuthor")
  logEntriesResolved    LogEntry[]           @relation("LogEntryResolver")
  reservationImports    ReservationImport[]
}

// Board "groups" — managed categories that tasks are organized under (monday.com style).
model Category {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#0073ea")
  position    Int      @default(0)
  locationId  String? // null = company-wide
  createdById String
  createdAt   DateTime @default(now())

  createdBy User   @relation(fields: [createdById], references: [id])
  tasks     Task[]
  checklistTemplates ChecklistTemplate[]

  @@index([position])
}

// A project groups related tasks for a client/initiative (monday "Customer Projects").
model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  client      String? // customer / account name
  status      ProjectStatus @default(NOT_STARTED)
  priority    Priority      @default(MEDIUM)
  color       String        @default("#440E48")
  locationId  String
  ownerId     String?
  budget      Float? // planned budget in dollars
  startAt     DateTime?
  dueAt       DateTime?
  position    Int           @default(0)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  location    Location     @relation(fields: [locationId], references: [id])
  owner       User?        @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdBy   User         @relation("ProjectCreator", fields: [createdById], references: [id])
  tasks       Task[]
  attachments Attachment[]

  @@index([locationId, status])
  @@index([status, position])
}

model Task {
  id            String     @id @default(cuid())
  title         String
  description   String?
  type          TaskType   @default(ONE_OFF)
  priority      Priority   @default(MEDIUM)
  locationId    String
  assigneeId    String?
  assignerId    String
  department    String?
  categoryId    String?
  projectId     String?
  complianceScheduleId String?
  position      Int        @default(0)
  amount        Float? // optional dollar value (e.g. cash-flow rows)
  startAt       DateTime? // optional future start date — task "activates" / notifies on this day
  startNotified Boolean    @default(false) // set once the start-day reminder has fired
  dueAt         DateTime?
  status        TaskStatus @default(PENDING)
  proofRequired Boolean    @default(false)
  archived      Boolean    @default(false)
  archivedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  location    Location         @relation(fields: [locationId], references: [id])
  category    Category?        @relation(fields: [categoryId], references: [id])
  project     Project?         @relation(fields: [projectId], references: [id])
  complianceSchedule ComplianceSchedule? @relation("ComplianceTasks", fields: [complianceScheduleId], references: [id])
  currentOfSchedule  ComplianceSchedule? @relation("ComplianceCurrentTask")
  assignee    User?            @relation("Assignee", fields: [assigneeId], references: [id])
  assigner    User             @relation("Assigner", fields: [assignerId], references: [id])
  attachments Attachment[]
  completions TaskCompletion[]
  comments    Comment[]
  subtasks    Subtask[]

  @@index([locationId, status])
  @@index([assigneeId, status])
  @@index([categoryId, position])
  @@index([projectId, position])
  @@index([complianceScheduleId])
  @@index([archived, status])
}

model TaskCompletion {
  id            String    @id @default(cuid())
  taskId        String
  completedById String
  completedAt   DateTime  @default(now())
  photoUrls     Json
  locationStamp String?
  verifiedById  String?
  verifiedAt    DateTime?

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy User  @relation("CompletedBy", fields: [completedById], references: [id])
  verifiedBy  User? @relation("VerifiedBy", fields: [verifiedById], references: [id])
}

model Attachment {
  id        String         @id @default(cuid())
  taskId    String?
  projectId String?
  type      AttachmentType
  url       String
  name      String?
  createdAt DateTime       @default(now())

  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Phase 2: Recurring Checklists
model ChecklistTemplate {
  id               String    @id @default(cuid())
  name             String
  frequency        Frequency
  items            Json // string[] — each item becomes one Task on generation
  locationId       String? // null = apply to all locations
  autoGenerateHour Int       @default(7) // 0-23 UTC hour to generate
  weekDay          Int? // 0-6 (0=Sun) — WEEKLY only
  monthDay         Int? // 1-31 — MONTHLY only
  priority         Priority  @default(MEDIUM)
  department       String?
  proofRequired    Boolean   @default(false)
  active           Boolean   @default(true)
  assigneeId       String? // default owner for generated tasks (null = unassigned)
  categoryId       String? // tag generated tasks with this board category
  createdById      String
  createdAt        DateTime  @default(now())

  location    Location?             @relation(fields: [locationId], references: [id])
  createdBy   User                  @relation("ChecklistCreator", fields: [createdById], references: [id])
  assignee    User?                 @relation("ChecklistAssignee", fields: [assigneeId], references: [id])
  category    Category?             @relation(fields: [categoryId], references: [id])
  generations ChecklistGeneration[]

  @@index([assigneeId])
}

// Tracks each time a template was run, preventing duplicate daily generates.
model ChecklistGeneration {
  id          String   @id @default(cuid())
  templateId  String
  locationId  String
  generatedAt DateTime @default(now())
  taskIds     Json // string[] of created Task ids

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, locationId, generatedAt])
}

// Daily notes — free-form log of extra / ad-hoc work, browsable day by day.
model DailyNote {
  id         String   @id @default(cuid())
  userId     String
  locationId String?
  body       String
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])

  @@index([userId, createdAt])
}

// Area Manager Action Plan task definitions. Editable from the UI so Hang/Sujee
// can add/remove items without a code deploy.
model ActionPlanTask {
  id            String   @id @default(cuid())
  page          String   @default("action-plan") // "action-plan" | "marketing"
  tab           String   // "weekly" | "monthly" | "vendor"
  taskKey       String   @unique // stable key used in ActionPlanEntry references
  name          String
  category      String?
  location      String?
  days          Int[]    @default([])
  dueDay        Int?
  deadlineMode  String?  // "same" | "next_month_15"
  mode          String?  // "all" | "grid"
  applicable    String[] @default([])
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// Area Manager Action Plan tracker (Hang / Sujee). A flat key/value store: one
// row per (period, key). period is an ISO week ("2026-W26") for weekly + summary
// data, or a calendar month ("2026-06") for monthly + vendor data. Shared by both
// users — no per-user dimension. updatedById is audit-only (no FK on purpose).
model ActionPlanEntry {
  id          String   @id @default(cuid())
  page        String   @default("action-plan") // "action-plan" | "marketing"
  period      String
  key         String
  value       String
  updatedById String
  updatedAt   DateTime @updatedAt

  @@unique([page, period, key])
  @@index([page, period])
}

// Phase 2: In-app notifications
model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  entityId   String? // e.g. Task id
  entityType String? // e.g. "Task"
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

// Phase 4: Announcements
model Announcement {
  id         String   @id @default(cuid())
  title      String
  body       String
  authorId   String
  locationId String? // null = company-wide
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())

  author   User               @relation(fields: [authorId], references: [id])
  location Location?          @relation(fields: [locationId], references: [id])
  reads    AnnouncementRead[]

  @@index([locationId, createdAt])
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
}

// Phase 4: LMS — Course / Lesson
model Course {
  id          String           @id @default(cuid())
  title       String
  description String?
  category    TrainingCategory
  thumbnail   String?
  locationId  String?
  published   Boolean          @default(true)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy User      @relation("CourseCreator", fields: [createdById], references: [id])
  location  Location? @relation(fields: [locationId], references: [id])
  lessons   Lesson[]

  @@index([locationId, category])
}

model Lesson {
  id         String     @id @default(cuid())
  courseId    String
  title      String
  content    String?
  contentUrl String?
  type       LessonType @default(ARTICLE)
  duration   Int?
  position   Int        @default(0)
  imageUrls  String[]   @default([])
  fileUrls   String[]   @default([])
  createdAt  DateTime   @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, position])
}

// Legacy flat materials (kept for data compatibility)
model TrainingMaterial {
  id          String           @id @default(cuid())
  title       String
  description String?
  category    TrainingCategory
  contentUrl  String?
  content     String?
  locationId  String? // null = company-wide
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy User      @relation(fields: [createdById], references: [id])
  location  Location? @relation(fields: [locationId], references: [id])

  @@index([locationId, category])
}

// Checklist of sub-steps within a task
model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

// Task discussion thread
model Comment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId, createdAt])
}

// Phase 5: Inventory — par-levels + periodic snapshot counts
model InventoryItem {
  id           String        @id @default(cuid())
  name         String
  sku          String?
  unit         InventoryUnit @default(EACH)
  category     String? // free text: "Dry goods", "Beverage", "Cleaning"
  locationId   String
  parLevel     Float? // target on-hand
  reorderLevel Float? // at/below this -> low-stock alert
  currentQty   Float         @default(0) // snapshot from latest submitted count
  active       Boolean       @default(true)
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  location  Location             @relation(fields: [locationId], references: [id])
  createdBy User                 @relation(fields: [createdById], references: [id])
  lines     InventoryCountLine[]

  @@index([locationId, active])
}

model InventoryCount {
  id          String   @id @default(cuid())
  locationId  String
  countedById String
  status      String   @default("SUBMITTED") // DRAFT | SUBMITTED
  note        String?
  countedAt   DateTime @default(now())

  location  Location             @relation(fields: [locationId], references: [id])
  countedBy User                 @relation(fields: [countedById], references: [id])
  lines     InventoryCountLine[]

  @@index([locationId, countedAt])
}

model InventoryCountLine {
  id          String @id @default(cuid())
  countId     String
  itemId      String
  countedQty  Float
  previousQty Float // currentQty at time of count (for variance)

  count InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  item  InventoryItem  @relation(fields: [itemId], references: [id])

  @@index([itemId])
}

// Phase 5: Maintenance requests
model MaintenanceRequest {
  id             String            @id @default(cuid())
  title          String
  description    String?
  area           MaintenanceArea   @default(OTHER)
  priority       Priority          @default(MEDIUM)
  status         MaintenanceStatus @default(OPEN)
  locationId     String
  reportedById   String
  assignedToId   String?
  vendor         String? // external vendor name (optional)
  photoUrls      Json // before/after photos (same pattern as TaskCompletion)
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  cost           Float?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  location   Location             @relation(fields: [locationId], references: [id])
  reportedBy User                 @relation("MaintReporter", fields: [reportedById], references: [id])
  assignedTo User?                @relation("MaintAssignee", fields: [assignedToId], references: [id])
  resolvedBy User?                @relation("MaintResolver", fields: [resolvedById], references: [id])
  comments   MaintenanceComment[]

  @@index([locationId, status])
  @@index([assignedToId, status])
}

model MaintenanceComment {
  id        String   @id @default(cuid())
  requestId String
  userId    String
  body      String
  createdAt DateTime @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id])

  @@index([requestId, createdAt])
}

// Logbook — daily operational log per location (Operations / Sales-Metrics /
// Customer Complaints / Action Needed). AI risk analysis runs automatically on
// creation (see src/lib/logbook-ai.ts) and populates aiRiskLevel/aiSummary;
// HIGH-risk entries surface in the Attention Queue until resolved.
enum LogDepartment {
  FOH
  BOH
}

enum LogCategory {
  OPERATIONS
  SALES_METRICS
  CUSTOMER_COMPLAINT
  ACTION_NEEDED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model LogEntry {
  id           String        @id @default(cuid())
  locationId   String
  authorId     String
  category     LogCategory
  department   LogDepartment
  body         String
  itemTag      String? // free-text dish/ingredient reference, autocompleted client-side
  photoUrls    Json          @default("[]") // string[] via FileDropzone/upload-client

  aiRiskLevel  RiskLevel?
  aiSummary    String?
  aiAnalyzedAt DateTime?

  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())

  location   Location @relation(fields: [locationId], references: [id])
  author     User     @relation("LogEntryAuthor", fields: [authorId], references: [id])
  resolvedBy User?    @relation("LogEntryResolver", fields: [resolvedById], references: [id])

  @@index([locationId, createdAt])
  @@index([locationId, category, createdAt])
  @@index([aiRiskLevel, resolvedAt])
}

// Daily reservation-book upload (host manually exports a CSV from the
// reservation system each day) — powers the /reservations host dashboard.
// One import per location per night; re-uploading the same night replaces it.
model ReservationImport {
  id           String   @id @default(cuid())
  locationId   String
  businessDate String // "YYYY-MM-DD" — the night this data covers, derived from
                       // the CSV's own reservedTime values, not upload time
  uploadedById String
  fileName     String?
  rowCount     Int
  createdAt    DateTime @default(now())

  location   Location            @relation(fields: [locationId], references: [id])
  uploadedBy User                @relation(fields: [uploadedById], references: [id])
  records    ReservationRecord[]

  @@unique([locationId, businessDate])
  @@index([locationId, businessDate])
}

model ReservationRecord {
  id                String   @id @default(cuid())
  importId          String
  reservedAt        DateTime
  telephone         String?
  customerName      String
  numberOfGuests    Int
  assignedTables    String? // raw comma-list from the CSV, kept for a future floor-map feature
  status            String  // external system's vocabulary (CANCELLED, SMS_CONFIRM,
                             // WAITING, ...) — kept as plain String, not validated/transitioned
  source            String?
  hoursCategory     String?
  additionalRequest String?

  import ReservationImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
}

// Table-number -> floor-section grouping, used by the Reservation dashboard's
// Floor Pressure Map. One row per zone per location (not per table) — a zone's
// table numbers live in `tableIds` since the whole zone is edited as a unit.
// Table numbering is location-specific (each branch's reservation system uses
// its own scheme), so this is scoped per location, not shared. Zones are added
// incrementally as branches confirm their table layout — an unmapped table
// number just doesn't show up in any zone yet.
model FloorZone {
  id         String   @id @default(cuid())
  locationId String
  name       String // e.g. "L Section", "R Section", "Tunnel"
  tableIds   String[] // e.g. ["L1","L2",...,"L15"]
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id])

  @@unique([locationId, name])
  @@index([locationId])
}

// Recurring compliance service schedule — spawns a Task each cycle and rolls the
// next due date forward from the last completed service date (anniversary-based).
model ComplianceSchedule {
  id            String             @id @default(cuid())
  name          String
  category      ComplianceCategory @default(OTHER)
  interval      ComplianceInterval @default(QUARTERLY)
  locationId    String
  assigneeId    String?
  vendor        String?
  vendorContact String?
  priority      Priority           @default(HIGH)
  estimatedCost Float?
  lastCost      Float?
  notes         String?
  lastServiceDate DateTime
  nextDueDate     DateTime
  remindersSent Json               @default("[]") // day-thresholds already alerted this cycle
  lastOverdueAlert DateTime?       // last overdue reminder, to throttle repeats
  active        Boolean            @default(true)
  currentTaskId String?            @unique
  createdById   String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  location    Location @relation(fields: [locationId], references: [id])
  assignee    User?    @relation("ComplianceAssignee", fields: [assigneeId], references: [id])
  createdBy   User     @relation("ComplianceCreator", fields: [createdById], references: [id])
  currentTask Task?               @relation("ComplianceCurrentTask", fields: [currentTaskId], references: [id])
  tasks       Task[]              @relation("ComplianceTasks")
  comments    ComplianceComment[]

  @@index([locationId, active])
  @@index([nextDueDate])
}

model ComplianceComment {
  id         String   @id @default(cuid())
  scheduleId String
  userId     String
  body       String
  createdAt  DateTime @default(now())

  schedule ComplianceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id])

  @@index([scheduleId, createdAt])
}

// Server (waitstaff) performance — one row per server per location per business
// day. Fed by an external API (the company website / POS) via /api/performance.
model ServerPerformance {
  id          String   @id @default(cuid())
  serverId    String
  locationId  String
  date        DateTime // business day (normalized to midnight)
  sales       Float    @default(0)
  covers      Int      @default(0)
  tips        Float    @default(0)
  upsells     Int      @default(0)
  reviewScore Float? // 0–5 average guest rating
  source      String   @default("api")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  server   User     @relation("ServerPerf", fields: [serverId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([serverId, locationId, date])
  @@index([locationId, date])
}

// Branch discussion channel message. locationId null = company-wide channel.
// Replaces scattered WhatsApp groups with one accountable, searchable place.
model Message {
  id         String   @id @default(cuid())
  locationId String?
  userId     String
  body       String
  mentions   Json     @default("[]") // userId[] @-mentioned in this message
  createdAt  DateTime @default(now())

  location Location? @relation(fields: [locationId], references: [id])
  user     User      @relation(fields: [userId], references: [id])

  @@index([locationId, createdAt])
}

// Immutable audit trail — heart of the system (Who / What / Where / When).
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String // e.g. "task.created", "task.status_changed", "task.verified"
  entity     String // e.g. "Task"
  entityId   String
  locationId String?
  meta       Json
  timestamp  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@index([locationId, timestamp])
  @@index([userId, timestamp])
}

// Private management notes pinned to a person's profile. Visible only to
// OWNER / AREA_MANAGER (see src/lib/person-notes.ts). Displayed as sticky notes.
enum NoteColor {
  YELLOW
  PINK
  GREEN
  BLUE
  PURPLE
}

model PersonNote {
  id        String    @id @default(cuid())
  subjectId String // the user the note is about
  authorId  String // who wrote it
  title     String?
  body      String
  color     NoteColor @default(YELLOW)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subject User @relation("NoteSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  author  User @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([subjectId, createdAt])
}

// Org-wide notification timing settings (singleton row, id = "default").
// Drives the daily cron reminders. Editable by OWNER / AREA_MANAGER.
model NotificationSettings {
  id                         String   @id @default("default")
  nearDueEnabled             Boolean  @default(true)
  nearDueHours               Int      @default(2) // remind this many hours before a task is due
  complianceRemindersEnabled Boolean  @default(true)
  complianceThresholds       Int[]    @default([14, 7, 3, 1]) // advance reminder days
  pushEnabled                Boolean  @default(true) // master switch for cron push
  updatedAt                  DateTime @updatedAt
  updatedById                String?
}

// Web Push subscriptions (one per browser/device). Used to deliver real-time
// notifications via the service worker. Endpoint is unique per subscription.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
